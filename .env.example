# Server-only HTTPS endpoint that stores/delivers inquiries. Never use NEXT_PUBLIC_ for secrets.
INQUIRY_WEBHOOK_URL=
INQUIRY_WEBHOOK_TOKEN=
# Optional exact origin for non-Vercel previews (no trailing slash).
SITE_ORIGIN=
# Optional HTTPS booking override, shown directly on Contact and after successful inquiry delivery.
NEXT_PUBLIC_BOOKING_URL=
# Approved public GA4 Measurement ID. Enable after final analytics/privacy review.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-QLJYT1B3XH
NEXT_PUBLIC_GA_ENABLED=false
# Enables indexing and sitemap inclusion for the privacy page after approval.
PRIVACY_POLICY_APPROVED=false
